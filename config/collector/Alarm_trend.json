{
  "communications": [
    {
      "name": "PLC1",
      "type": "opcua",
      "host": "192.168.50.233",
      "port": 4840
    }
  ],
  "connections": [
    {
      "name": "connection1",
      "communication": "PLC1",
      "data_groups": [
        "alarm_group_1",
        "trend_group_1"
      ],
      "heartbeat": "guiDBHeartBeat"
    }
  ],
  "points": [
    {
      "name": "guiDBHeartBeat",
      "path": "ns=6;s=::AsGlobalPV:guiDBHeartBeat",
      "description": "数据库心跳点位"
    },
    {
      "name": "Trenddata",
      "path": "ns=6;s=::Trend:Trenddata",
      "description": "趋势数据"
    },
    {
      "name": "ts",
      "path": "ns=6;s=::AlarmQuerr:ts",
      "description": "报警时间戳",
      "datatype": "datetime"
    },
    {
      "name": "code",
      "path": "ns=6;s=::AlarmQuerr:Code",
      "description": "报警码"
    },
    {
      "name": "msg",
      "path": "ns=6;s=::AlarmQuerr:msg",
      "description": "报警信息"
    },
    {
      "name": "severity",
      "path": "ns=6;s=::AlarmQuerr:severity",
      "description": "报警等级"
    },
    {
      "name": "Status",
      "path": "ns=6;s=::AlarmQuerr:Status",
      "description": "报警状态"
    },
    {
      "name": "Batch",
      "path": "ns=6;s=::AlarmQuerr:Batch",
      "description": "生产批号"
    },
    {
      "name": "bTrigger1",
      "path": "ns=6;s=::AlarmQuerr:btrigger",
      "description": "PLC1测试REAL数据"
    },
    {
      "name": "bTriggerQuery1",
      "path": "ns=6;s=::AlarmQuerr:bExecuteRead",
      "description": "用于触发查询任务"
    },
    {
      "name": "bTriggerQuery2",
      "path": "ns=6;s=::Trend:bExecuteRead",
      "description": "用于触发查询任务"
    },
    {
      "name": "strStartTimes1",
      "path": "ns=6;s=::AlarmQuerr:stDbReadQuery.stConfig.strStartTime",
      "description": ""
    },
    {
      "name": "strEndTimes1",
      "path": "ns=6;s=::AlarmQuerr:stDbReadQuery.stConfig.strEndTime",
      "description": ""
    },
    {
      "name": "strPointNames1",
      "path": "ns=6;s=::AlarmQuerr:stDbReadQuery.stConfig.strPointName",
      "description": ""
    },
    {
      "name": "strAuxQuery1",
      "path": "ns=6;s=::AlarmQuerr:stDbReadQuery.stConfig.strAuxQuery",
      "description": "附加查询指令，SELECT XX FROM table_name WHERE point_name BETWEEN 开始时间 AND 结束时间 AND (strAuxQuery);"
    },
    {
      "name": "strStartTimes2",
      "path": "ns=6;s=::Trend:stDbReadQuery.stConfig.strStartTime",
      "description": ""
    },
    {
      "name": "strEndTimes2",
      "path": "ns=6;s=::Trend:stDbReadQuery.stConfig.strEndTime",
      "description": ""
    },
    {
      "name": "strPointNames2",
      "path": "ns=6;s=::Trend:stDbReadQuery.stConfig.strPointName",
      "description": ""
    },
    {
      "name": "strAuxQuery2",
      "path": "ns=6;s=::Trend:stDbReadQuery.stConfig.strAuxQuery",
      "description": "附加查询指令，SELECT XX FROM table_name WHERE point_name BETWEEN 开始时间 AND 结束时间 AND (strAuxQuery);"
    }
  ],
  "groups": [
    {
      "name": "alarm_group_1",
      "interval_seconds": 0.2,
      "trigger": "variable",
      "description": "每0.2s检查一次trigger变量",
      "data_points": [
        "ts",
        "code",
        "msg",
        "severity",
        "Status",
        "Batch"
      ],
      "trigger_point": "bTrigger1",
      "reset_trigger_after_read": false,
      "recreate_interval_days": 1,
      "batch_insert_size": 1
    },
    {
      "name": "trend_group_1",
      "interval_seconds": 2,
      "trigger": "time",
      "description": "趋势数据采集组，每 2 秒采集一次",
      "data_points": [
        "Trenddata"
      ],
      "trigger_point": null,
      "recreate_interval_days": 1,
      "batch_insert_size": 5
    }
  ],
