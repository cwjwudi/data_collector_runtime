  "groups": [
    {
      "name": "Data_Recipe",
      "interval_seconds": 1,
      "trigger": "variable",
      "description": "配方数据采集-事件触发",
      "data_points": [
        "DataRecipeTime",
        "DataRecipeState",
        "DataRecipeCH00",
        "DataRecipeCH01",
