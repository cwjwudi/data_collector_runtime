        "DataRecipeCH24",
        "DataRecipeCH25",
        "BatchCode"
      ],
      "trigger_point": "RecipeInsertTrigger",
      "enable_point": "RecipeCollectEnable",
      "reset_trigger_after_read": true,
      "recreate_interval_days": 1,
      "batch_insert_size": 5,
      "is_parallel": false,
      "trigger_interval_seconds": 1,
      "partition_interval_years": 1,
      "trigger_mode": "poll"
    },
