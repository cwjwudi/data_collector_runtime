(*DataSQL constants / globals matching sma_data_collect*)
VAR CONSTANT
	DATA_SQL_QUERY_SIZE : UINT := 30;
	DATA_SQL_QUERY_SIZE_MINUS : UINT := DATA_SQL_QUERY_SIZE - 1;
	(*Parallel Alarm/Audit buffer size (is_parallel)*)
	DATA_SQL_PARALLEL_SIZE : UINT := 100;
	DATA_SQL_PARALLEL_SIZE_MINUS : UINT := DATA_SQL_PARALLEL_SIZE - 1;
END_VAR
VAR
	gDataSQLHeartBeat : UINT;
	gDataSQLCommFault : BOOL;
	gDataSQLOperate : DataSQLOperate_typ;
	gDataSQLRecipe : DataSQLRecipe_typ;
	gDataSQLProduct : DataSQLProduct_typ;
	gDataSQLBatch : DataSQLBatch_typ;
	gDataSQLBatchInfo : DataSQLBatchInfo_typ;
	gDataSQLBatchOpen : BOOL;
END_VAR
